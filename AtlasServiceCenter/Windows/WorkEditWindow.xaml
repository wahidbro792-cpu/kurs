<Window x:Class="AtlasServiceCenter.Windows.WorkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Работа"
        Height="220"
        Width="420"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">

            <TextBlock Text="Наименование работы:"/>
            <TextBox x:Name="WorkNameBox" Margin="0,3,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Цена:" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="PriceBox" Width="100"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Кол-во:" Width="80" VerticalAlignment="Center"/>
                <TextBox x:Name="QuantityBox" Width="100"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="OK"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="OkButton_Click"/>
            <Button Content="Отмена"
                    Width="90"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
