<Window x:Class="AtlasServiceCenter.Windows.BonusEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Премия сотруднику"
        Height="260"
        Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LightBackgroundBrush}"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Карточка -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>

                <TextBlock Text="Сотрудник:"
                           Margin="0,0,0,2"/>
                <TextBlock x:Name="EmployeeNameText"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Дата премии:"
                               Width="120"
                               VerticalAlignment="Center"/>
                    <DatePicker x:Name="BonusDatePicker"
                                Width="150"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Сумма:"
                               Width="120"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="AmountBox"
                             Width="150"/>
                </StackPanel>

                <TextBlock Text="Причина:"
                           Margin="0,5,0,2"/>
                <TextBox x:Name="ReasonBox"
                         Height="70"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <!-- OK -->
            <Button Width="110"
                    Margin="0,0,10,0"
                    Style="{StaticResource GoldButtonStyle}"
                    Click="OkButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Icons/issue.png"
                           Width="16" Height="16"
                           Margin="0,0,6,0"/>
                    <TextBlock Text="OK"/>
                </StackPanel>
            </Button>

            <!-- Отмена -->
            <Button Width="110"
                    Style="{StaticResource GoldButtonStyle}"
                    Click="CancelButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Icons/edit.png"
                           Width="16" Height="16"
                           Margin="0,0,6,0"/>
                    <TextBlock Text="Отмена"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
