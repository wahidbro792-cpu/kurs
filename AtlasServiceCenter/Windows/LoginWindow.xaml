<Window x:Class="AtlasServiceCenter.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация | Атлас Сервис Центр"
        Height="319"
        Width="442"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource LightBackgroundBrush}">

    <Grid Margin="20">
        <!-- Центруем карточку авторизации -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource GoldBrush}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Атлас Сервис Центр"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}" RenderTransformOrigin="0.445,0.304"/>
                        <TextBlock Text="Вход в систему"
                                   FontSize="14"
                                   Foreground="#FF555555"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Поля логина/пароля -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <TextBlock Text="Логин:"
                                       Width="90"
                                       VerticalAlignment="Center"
                                       Foreground="#FF333333"/>
                            <TextBox x:Name="LoginTextBox"
                                     Width="220"
                                     Height="26"
                                     Margin="0,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Пароль:"
                                       Width="90"
                                       VerticalAlignment="Center"
                                       Foreground="#FF333333"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Width="220"
                                         Height="26"/>
                        </StackPanel>

                        <TextBlock x:Name="ErrorTextBlock"
                                   Foreground="Red"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,15,0,0">
                        <Button Width="110"
                                Margin="0,0,10,0"
                                Click="LoginButton_Click"
                                Style="{StaticResource GoldButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Icons/login.png"
                                       Width="16" Height="16"
                                       Margin="0,0,6,0"/>
                                <TextBlock Text="Войти"/>
                            </StackPanel>
                        </Button>

                        <Button Width="110"
                                Click="ExitButton_Click"
                                Style="{StaticResource GoldButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Icons/exit.png"
                                       Width="16" Height="16"
                                       Margin="0,0,6,0"/>
                                <TextBlock Text="Выход"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
