<Window x:Class="AtlasServiceCenter.Windows.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник"
        Height="380"
        Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LightBackgroundBrush}"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <!-- Карточка окна -->
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Основной блок -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,10">

                    <TextBlock Text="Карточка сотрудника"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="ФИО:"
                                   Width="130"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="FullNameBox"
                                 Width="320"
                                 Height="26"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Должность:"
                                   Width="130"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="PositionComboBox"
                                  Width="220"
                                  Height="26"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="PositionId"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Дата приёма:"
                                   Width="130"
                                   VerticalAlignment="Center"/>
                        <DatePicker x:Name="HireDatePicker"
                                    Width="150"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Дата увольнения:"
                                   Width="130"
                                   VerticalAlignment="Center"/>
                        <DatePicker x:Name="FireDatePicker"
                                    Width="150"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Базовый оклад:"
                                   Width="130"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="BaseSalaryBox"
                                 Width="150"
                                 Height="26"/>
                    </StackPanel>

                    <CheckBox x:Name="IsActiveCheckBox"
                              Content="Работает (активен)"
                              Margin="2,10,0,0"/>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="110"
                            Margin="0,0,10,0"
                            Click="SaveButton_Click"
                            Style="{StaticResource GoldButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Icons/save.png"
                                   Width="16" Height="16"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="Сохранить"/>
                        </StackPanel>
                    </Button>

                    <Button Width="110"
                            Click="CloseButton_Click"
                            Style="{StaticResource GoldButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Icons/exit.png"
                                   Width="16" Height="16"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="Закрыть"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
