<Window x:Class="AtlasServiceCenter.Windows.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиент"
        Height="500"
        Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LightBackgroundBrush}"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Карточка клиента -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ФИО -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <TextBlock Text="ФИО:"
                               Width="100"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="FullNameBox"
                             Width="360"
                             Height="26"/>
                </StackPanel>

                <!-- Телефон -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <TextBlock Text="Телефон:"
                               Width="100"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="PhoneBox"
                             Width="220"
                             Height="26"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <TextBlock Text="Email:"
                               Width="100"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="EmailBox"
                             Width="260"
                             Height="26"/>
                </StackPanel>

                <!-- Заметки -->
                <StackPanel Grid.Row="3"
                            Margin="0,5,0,8">
                    <TextBlock Text="Заметки:"
                               Margin="0,0,0,2"/>
                    <TextBox x:Name="NotesBox"
                             Height="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Устройства клиента -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="Устройства клиента:"
                               FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <DataGrid x:Name="DevicesGrid"
                              Height="170"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MouseDoubleClick="DevicesGrid_MouseDoubleClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Нижняя панель кнопок -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <!-- Добавить устройство -->
            <Button Width="180"
                    Margin="0,0,10,0"
                    Style="{StaticResource GoldButtonStyle}"
                    Click="AddDeviceButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Icons/add.png"
                           Width="16" Height="16"
                           Margin="0,0,6,0"/>
                    <TextBlock Text="Добавить устройство"/>
                </StackPanel>
            </Button>

            <!-- Сохранить -->
            <Button Width="120"
                    Margin="0,0,10,0"
                    Style="{StaticResource GoldButtonStyle}"
                    Click="SaveButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Icons/save.png"
                           Width="16" Height="16"
                           Margin="0,0,6,0"/>
                    <TextBlock Text="Сохранить"/>
                </StackPanel>
            </Button>

            <!-- Закрыть -->
            <Button Width="120"
                    Style="{StaticResource GoldButtonStyle}"
                    Click="CloseButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Icons/edit.png"
                           Width="16" Height="16"
                           Margin="0,0,6,0"/>
                    <TextBlock Text="Закрыть"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
