<Window x:Class="AtlasServiceCenter.Windows.PartCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запчасть"
        Height="320"
        Width="480"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Название:"
                           Width="110"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="NameBox"
                         Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Артикул (SKU):"
                           Width="110"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="SkuBox"
                         Width="200"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Остаток на складе:"
                           Width="110"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="QuantityBox"
                         Width="100"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Закупочная цена:"
                           Width="110"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="PurchasePriceBox"
                         Width="100"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Продажная цена:"
                           Width="110"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="SalePriceBox"
                         Width="100"/>
            </StackPanel>

            <CheckBox x:Name="IsActiveCheckBox"
                      Content="Запчасть активна (используется в заказах)"
                      Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Сохранить"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            <Button Content="Закрыть"
                    Width="100"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
