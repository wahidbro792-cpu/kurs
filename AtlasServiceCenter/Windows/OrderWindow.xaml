<Window x:Class="AtlasServiceCenter.Windows.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ"
        Height="750"
        Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Основная часть -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: основные поля -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Клиент:" Width="100"/>
                    <ComboBox x:Name="ClientComboBox"
                              Width="220"
                              DisplayMemberPath="FullName"
                              SelectedValuePath="ClientId"
                              SelectionChanged="ClientComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Устройство:" Width="100"/>
                    <ComboBox x:Name="DeviceComboBox"
                              Width="220"
                              DisplayMemberPath="DeviceDisplay"
                              SelectedValuePath="DeviceId"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Статус:" Width="100"/>
                    <ComboBox x:Name="StatusComboBox"
                              Width="220"
                              DisplayMemberPath="Name"
                              SelectedValuePath="StatusId"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Мастер:" Width="100"/>
                    <ComboBox x:Name="MasterComboBox"
                              Width="220"
                              DisplayMemberPath="FullName"
                              SelectedValuePath="EmployeeId"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                    <TextBlock Text="Скидка %:" Width="100"/>
                    <TextBox x:Name="DiscountTextBox"
                             Width="80"
                             TextChanged="DiscountTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Итого:" Width="100"/>
                    <TextBox x:Name="TotalAmountTextBox"
                             Width="120"
                             IsReadOnly="True"/>
                </StackPanel>

                <CheckBox x:Name="IsPaidCheckBox"
                          Content="Оплачен"
                          Margin="0,0,0,5"/>
                <CheckBox x:Name="IsIssuedCheckBox"
                          Content="Выдан"/>

                <TextBlock Text="Проблема:"
                           Margin="0,15,0,3"/>
                <TextBox x:Name="ProblemTextBox"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>

                <TextBlock Text="Комментарий:"
                           Margin="0,15,0,3"/>
                <TextBox x:Name="CommentTextBox"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Правая колонка: работы и запчасти -->
            <TabControl Grid.Column="1">

                <!-- Работы -->
                <TabItem Header="Работы">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Top"
                                    Margin="0,0,0,5">
                            <Button Content="Добавить"
                                    Margin="0,0,5,0"
                                    Click="AddWorkButton_Click"/>
                            <Button Content="Изменить"
                                    Margin="0,0,5,0"
                                    Click="EditWorkButton_Click"/>
                            <Button Content="Удалить"
                                    Click="DeleteWorkButton_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="WorksGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Услуга" Binding="{Binding WorkName}" Width="*"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="80"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Запчасти -->
                <TabItem Header="Запчасти">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Top"
                                    Margin="0,0,0,5">
                            <Button Content="Добавить"
                                    Margin="0,0,5,0"
                                    Click="AddPartButton_Click"/>
                            <Button Content="Изменить"
                                    Margin="0,0,5,0"
                                    Click="EditPartButton_Click"/>
                            <Button Content="Удалить"
                                    Click="DeletePartButton_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="PartsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Запчасть" Binding="{Binding PartName}" Width="*"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding PricePerUnit}" Width="80"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Низ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Пересчитать"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="RecalculateButton_Click"/>
            <Button Content="Сохранить"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            <Button Content="Печать акта"
                    Width="130"
                    Margin="0,0,10,0"
                    Click="PrintActButton_Click"/>
            <Button Content="Закрыть"
                    Width="100"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
