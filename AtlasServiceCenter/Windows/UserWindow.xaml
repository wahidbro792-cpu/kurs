<Window x:Class="AtlasServiceCenter.Windows.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь"
        Height="420"
        Width="480"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Логин:"
                           Width="110"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="LoginBox"
                         Width="250"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Пароль:"
                           Width="110"
                           VerticalAlignment="Center"/>
                <PasswordBox x:Name="PasswordBox"
                             Width="250"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Роль:"
                           Width="110"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="RoleComboBox"
                          Width="200"
                          DisplayMemberPath="Name"
                          SelectedValuePath="RoleId"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Сотрудник:"
                           Width="110"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="EmployeeComboBox"
                          Width="250"
                          DisplayMemberPath="FullName"
                          SelectedValuePath="EmployeeId"
                          IsEditable="False"
                          IsReadOnly="False"/>
            </StackPanel>

            <TextBlock Text="Привязка к сотруднику не обязательна, но желательно для мастеров/менеджеров."
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,5,0,10"/>

            <!-- Блок фото пользователя -->
            <GroupBox Header="Фотография пользователя" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Border Width="90" Height="90" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                        <Image x:Name="UserPhotoImage"
                               Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Button Content="Выбрать фото..."
                                Width="130"
                                Click="SelectPhotoButton_Click"
                                Margin="0,0,0,5"/>
                        <TextBlock Text="Изображение будет сохранено в папку UserPhotos рядом с программой."
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Width="230"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Сохранить"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            <Button Content="Закрыть"
                    Width="100"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
