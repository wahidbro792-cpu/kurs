<UserControl x:Class="AtlasServiceCenter.Pages.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Стиль для выравнивания чисел вправо -->
        <Style x:Key="RightAlignCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10"
          Background="{StaticResource CardBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + кнопки -->
        <Grid Grid.Row="0"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Заказы"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <Button Click="RefreshButton_Click"
                        Margin="0,0,8,0"
                        MinWidth="110"
                        Style="{StaticResource GoldButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/refresh.png"
                               Width="16" Height="16"
                               Margin="0,0,6,0"/>
                        <TextBlock Text="Обновить"/>
                    </StackPanel>
                </Button>

                <Button Click="NewOrderButton_Click"
                        Margin="0,0,8,0"
                        MinWidth="110"
                        Style="{StaticResource GoldButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/add.png"
                               Width="16" Height="16"
                               Margin="0,0,6,0"/>
                        <TextBlock Text="Новый"/>
                    </StackPanel>
                </Button>

                <Button Click="OpenOrderButton_Click"
                        Margin="0,0,8,0"
                        MinWidth="110"
                        Style="{StaticResource GoldButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/open.png"
                               Width="16" Height="16"
                               Margin="0,0,6,0"/>
                        <TextBlock Text="Открыть"/>
                    </StackPanel>
                </Button>

                <Button Click="DeleteOrderButton_Click"
                        MinWidth="110"
                        Style="{StaticResource GoldButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/delete.png"
                               Width="16" Height="16"
                               Margin="0,0,6,0"/>
                        <TextBlock Text="Удалить"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Фильтры -->
        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,10"
                   VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,10,4"
                        VerticalAlignment="Center">
                <TextBlock Text="Поиск:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <TextBox x:Name="SearchBox"
                         Width="180"
                         Height="26"
                         VerticalAlignment="Center"
                         ToolTip="Поиск по клиенту или устройству"
                         TextChanged="SearchBox_TextChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,10,4"
                        VerticalAlignment="Center">
                <TextBlock x:Name="StatusFilterLabel"
                           Text="Статус:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <ComboBox x:Name="StatusFilter"
                          Width="150"
                          VerticalAlignment="Center"
                          SelectionChanged="StatusFilter_SelectionChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,10,4"
                        VerticalAlignment="Center">
                <TextBlock x:Name="MasterFilterLabel"
                           Text="Мастер:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <ComboBox x:Name="MasterFilter"
                          Width="180"
                          VerticalAlignment="Center"
                          SelectionChanged="MasterFilter_SelectionChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,10,4"
                        VerticalAlignment="Center">
                <TextBlock Text="С:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <DatePicker x:Name="DateFrom"
                            Width="130"
                            SelectedDateChanged="DateFrom_SelectedDateChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,10,4"
                        VerticalAlignment="Center">
                <TextBlock Text="По:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <DatePicker x:Name="DateTo"
                            Width="130"
                            SelectedDateChanged="DateTo_SelectedDateChanged"/>
            </StackPanel>
        </WrapPanel>

        <!-- Таблица заказов -->
        <DataGrid x:Name="OrdersGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  MouseDoubleClick="OrdersGrid_MouseDoubleClick"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Background="{StaticResource CardBackgroundBrush}"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  RowHeaderWidth="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusName}" Value="Принят">
                            <Setter Property="Background" Value="#FFEFEFEF"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusName}" Value="В диагностике">
                            <Setter Property="Background" Value="#FFFFF3C4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusName}" Value="Диагностика">
                            <Setter Property="Background" Value="#FFFFF3C4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusName}" Value="Ожидает запчастей">
                            <Setter Property="Background" Value="#FFFFE0B2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusName}" Value="В работе">
                            <Setter Property="Background" Value="#FFD6ECFF"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusName}" Value="Готов">
                            <Setter Property="Background" Value="#FFDFF5DD"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusName}" Value="Выдан">
                            <Setter Property="Background" Value="#FFDCEBFF"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusName}" Value="Отказ">
                            <Setter Property="Background" Value="#FFFFD6D6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"
                                    Binding="{Binding OrderId}"
                                    Width="60"/>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding CreatedAt, StringFormat=d}"
                                    Width="100"/>
                <DataGridTextColumn Header="Клиент"
                                    Binding="{Binding ClientName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Устройство"
                                    Binding="{Binding DeviceName}"
                                    Width="180"/>
                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding StatusName}"
                                    Width="140"/>
                <DataGridTextColumn Header="Мастер"
                                    Binding="{Binding MasterName}"
                                    Width="180"/>
                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding TotalAmount}"
                                    Width="100"
                                    ElementStyle="{StaticResource RightAlignCell}"/>
                <DataGridCheckBoxColumn Header="Оплачен"
                                        Binding="{Binding IsPaid}"
                                        Width="80"/>
                <DataGridCheckBoxColumn Header="Выдан"
                                        Binding="{Binding IsIssued}"
                                        Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
