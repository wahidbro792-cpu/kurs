<UserControl x:Class="AtlasServiceCenter.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Выравнивание числовых колонок вправо (для суммы) -->
        <Style x:Key="RightAlignCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Отчёты по заказам"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Фильтры -->
        <Border Grid.Row="1"
                BorderBrush="#DDD"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10"
                Background="{DynamicResource CardBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center">

                    <!-- Период дат -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Период:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <DatePicker x:Name="FromDatePicker"
                                    Width="130"
                                    SelectedDateChanged="FilterChanged"/>
                        <TextBlock Text="—"
                                   Margin="5,0"
                                   VerticalAlignment="Center"/>
                        <DatePicker x:Name="ToDatePicker"
                                    Width="130"
                                    SelectedDateChanged="FilterChanged"/>
                    </StackPanel>

                    <!-- Только оплаченные -->
                    <CheckBox x:Name="OnlyPaidCheckBox"
                              Content="Только оплаченные"
                              Margin="10,0,10,0"
                              VerticalAlignment="Center"
                              Checked="FilterChanged"
                              Unchecked="FilterChanged"/>

                    <!-- Кнопки -->
                    <Button Margin="10,0,0,0"
                            MinWidth="110"
                            Click="RefreshButton_Click"
                            Style="{StaticResource GoldButtonStyle}">
                        <TextBlock Text="Обновить"/>
                    </Button>

                    <Button Margin="10,0,0,0"
                            MinWidth="140"
                            Click="ExportToWordButton_Click"
                            Style="{StaticResource GoldButtonStyle}">
                        <TextBlock Text="Экспорт в Word"/>
                    </Button>

                    <Button Margin="10,0,0,0"
                            MinWidth="170"
                            Click="OpenReportsFolderButton_Click"
                            Style="{StaticResource GoldButtonStyle}">
                        <TextBlock Text="Открыть папку отчётов"/>
                    </Button>

                </WrapPanel>
            </Grid>
        </Border>

        <!-- Таблица + итоги -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Таблица заказов -->
            <DataGrid x:Name="OrdersGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding OrderId}"
                                        Width="60"/>
                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding CreatedAt, StringFormat=d}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Клиент"
                                        Binding="{Binding ClientName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Устройство"
                                        Binding="{Binding DeviceName}"
                                        Width="180"/>
                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding StatusName}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Сумма"
                                        Binding="{Binding TotalAmount}"
                                        Width="100"
                                        ElementStyle="{StaticResource RightAlignCell}"/>
                    <DataGridCheckBoxColumn Header="Оплачен"
                                            Binding="{Binding IsPaid}"
                                            Width="80"/>
                    <DataGridCheckBoxColumn Header="Выдан"
                                            Binding="{Binding IsIssued}"
                                            Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Итоги -->
            <Border Grid.Row="1"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,8,0,0"
                    Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Всего заказов:"
                               FontWeight="Bold"
                               Margin="0,0,5,0"/>
                    <TextBlock x:Name="TotalOrdersText"
                               Margin="0,0,15,0"/>

                    <TextBlock Text="Закрыто/выдано:"
                               FontWeight="Bold"
                               Margin="0,0,5,0"/>
                    <TextBlock x:Name="ClosedOrdersText"
                               Margin="0,0,15,0"/>

                    <TextBlock Text="Выручка (оплаченные):"
                               FontWeight="Bold"
                               Margin="0,0,5,0"/>
                    <TextBlock x:Name="RevenueText"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
