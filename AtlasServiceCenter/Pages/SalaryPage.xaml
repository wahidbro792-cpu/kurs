<UserControl x:Class="AtlasServiceCenter.Pages.SalaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Зарплаты сотрудников"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Панель расчёта -->
        <Border Grid.Row="1"
                BorderBrush="#DDD"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10"
                Background="{DynamicResource CardBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0: сотрудник + период + кнопка -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1: суммы -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: комментарий + сохранить -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3: кнопки премий/штрафов -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Сотрудник + период + Рассчитать -->
                <WrapPanel Grid.Row="0"
                           Margin="0,0,0,5"
                           VerticalAlignment="Center">

                    <!-- Сотрудник -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,15,5"
                                VerticalAlignment="Center">
                        <TextBlock Text="Сотрудник:"
                                   Width="90"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="EmployeeComboBox"
                                  Width="220"
                                  DisplayMemberPath="FullName"
                                  SelectedValuePath="EmployeeId"
                                  SelectionChanged="EmployeeComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- Период -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,15,5"
                                VerticalAlignment="Center">
                        <TextBlock Text="Период:"
                                   Width="70"
                                   VerticalAlignment="Center"/>
                        <DatePicker x:Name="PeriodStartPicker"
                                    Width="120"/>
                        <TextBlock Text="—"
                                   Margin="5,0"
                                   VerticalAlignment="Center"/>
                        <DatePicker x:Name="PeriodEndPicker"
                                    Width="120"/>
                    </StackPanel>

                    <!-- Кнопка Рассчитать -->
                    <Button Content="Рассчитать"
                            MinWidth="120"
                            Margin="0,0,0,5"
                            Click="CalculateButton_Click"
                            Style="{StaticResource GoldButtonStyle}"/>
                </WrapPanel>

                <!-- Результаты расчёта -->
                <WrapPanel Grid.Row="1"
                           Margin="0,10,0,0"
                           VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,20,5"
                                VerticalAlignment="Center">
                        <TextBlock Text="Базовый оклад:"
                                   Width="130"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="BaseSalaryBox"
                                 Width="100"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,20,5"
                                VerticalAlignment="Center">
                        <TextBlock Text="Премии:"
                                   Width="70"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="BonusesBox"
                                 Width="100"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,20,5"
                                VerticalAlignment="Center">
                        <TextBlock Text="Штрафы:"
                                   Width="70"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="PenaltiesBox"
                                 Width="100"
                                 IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,5"
                                VerticalAlignment="Center">
                        <TextBlock Text="Итого к выплате:"
                                   Width="120"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="FinalAmountBox"
                                 Width="110"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Комментарий + сохранить выплату -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                        <TextBlock Text="Комментарий:"
                                   Width="90"
                                   VerticalAlignment="Top"/>
                        <TextBox x:Name="CommentBox"
                                 Height="60"
                                 Width="350"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10,0,0,0">
                        <Button Content="Сохранить выплату"
                                MinWidth="160"
                                Click="SavePaymentButton_Click"
                                Style="{StaticResource GoldButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Кнопки добавления премий и штрафов -->
                <WrapPanel Grid.Row="3"
                           Margin="0,10,0,0"
                           VerticalAlignment="Center">
                    <Button x:Name="AddBonusButton"
                            Content="Добавить премию"
                            MinWidth="150"
                            Margin="0,0,10,5"
                            Click="AddBonusButton_Click"
                            Style="{StaticResource GoldButtonStyle}"/>
                    <Button x:Name="AddPenaltyButton"
                            Content="Добавить штраф"
                            MinWidth="150"
                            Margin="0,0,10,5"
                            Click="AddPenaltyButton_Click"
                            Style="{StaticResource GoldButtonStyle}"/>
                    <TextBlock Text="Премии и штрафы учитываются в расчёте за выбранный период."
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               Margin="0,0,0,5"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- История выплат -->
        <DataGrid x:Name="PaymentsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding SalaryPaymentId}"
                                    Width="60"/>

                <DataGridTextColumn Header="Период с"
                                    Binding="{Binding PeriodStart, StringFormat=d}"
                                    Width="90"/>

                <DataGridTextColumn Header="по"
                                    Binding="{Binding PeriodEnd, StringFormat=d}"
                                    Width="90"/>

                <DataGridTextColumn Header="База"
                                    Binding="{Binding BaseSalary}"
                                    Width="80"/>

                <DataGridTextColumn Header="Премии"
                                    Binding="{Binding BonusesTotal}"
                                    Width="80"/>

                <DataGridTextColumn Header="Штрафы"
                                    Binding="{Binding PenaltiesTotal}"
                                    Width="80"/>

                <DataGridTextColumn Header="Итого"
                                    Binding="{Binding FinalAmount}"
                                    Width="90"/>

                <DataGridTextColumn Header="Дата выплаты"
                                    Binding="{Binding PaymentDate, StringFormat=d}"
                                    Width="100"/>

                <DataGridTextColumn Header="Комментарий"
                                    Binding="{Binding Comment}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
