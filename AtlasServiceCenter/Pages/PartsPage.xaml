<UserControl x:Class="AtlasServiceCenter.Pages.PartsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХ: заголовок + поиск/фильтры/кнопки -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Склад запчастей"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <WrapPanel Grid.Column="1"
                       VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Поиск:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBox x:Name="SearchBox"
                             Width="200"
                             Height="26"
                             VerticalAlignment="Center"
                             ToolTip="Поиск по названию или артикулу"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <CheckBox x:Name="ActiveOnlyCheckBox"
                          Content="Только активные"
                          IsChecked="True"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          Checked="ActiveOnlyCheckBox_Changed"
                          Unchecked="ActiveOnlyCheckBox_Changed"/>

                <Button Margin="0,0,8,0"
                        MinWidth="110"
                        Click="RefreshButton_Click"
                        Style="{StaticResource GoldButtonStyle}">
                    <TextBlock Text="Обновить"/>
                </Button>

                <Button Margin="0,0,8,0"
                        MinWidth="140"
                        Click="NewPartButton_Click"
                        Style="{StaticResource GoldButtonStyle}">
                    <TextBlock Text="Новая запчасть"/>
                </Button>

                <Button MinWidth="110"
                        Click="EditPartButton_Click"
                        Style="{StaticResource GoldButtonStyle}">
                    <TextBlock Text="Изменить"/>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- НИЗ: таблица запчастей -->
        <DataGrid x:Name="PartsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="PartsGrid_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding PartId}"
                                    Width="60"/>
                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="*"/>
                <DataGridTextColumn Header="Артикул"
                                    Binding="{Binding SKU}"
                                    Width="120"/>
                <DataGridTextColumn Header="Остаток"
                                    Binding="{Binding QuantityInStock}"
                                    Width="80"/>
                <DataGridTextColumn Header="Закупочная"
                                    Binding="{Binding PurchasePrice}"
                                    Width="110"/>
                <DataGridTextColumn Header="Продажная"
                                    Binding="{Binding SalePrice}"
                                    Width="110"/>
                <DataGridCheckBoxColumn Header="Активна"
                                        Binding="{Binding IsActive}"
                                        Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
