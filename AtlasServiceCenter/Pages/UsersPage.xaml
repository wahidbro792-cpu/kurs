<UserControl x:Class="AtlasServiceCenter.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: заголовок + поиск и кнопки -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0"
                       Text="Пользователи системы"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

            <!-- Поиск + кнопки, которые могут переноситься -->
            <WrapPanel Grid.Row="1"
                       VerticalAlignment="Center"
                       ItemHeight="30"
                       ItemWidth="Auto">

                <!-- Поиск -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Поиск:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBox x:Name="SearchBox"
                             Width="220"
                             Height="26"
                             VerticalAlignment="Center"
                             ToolTip="Поиск по логину или ФИО"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <!-- Обновить -->
                <Button x:Name="RefreshButton"
                        Margin="0,0,10,0"
                        MinWidth="120"
                        Click="RefreshButton_Click"
                        Style="{StaticResource GoldButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/refresh.png"
                               Width="16" Height="16"
                               Margin="0,0,6,0"/>
                        <TextBlock Text="Обновить"/>
                    </StackPanel>
                </Button>

                <!-- Новый пользователь -->
                <Button x:Name="NewUserButton"
                        Margin="0,0,10,0"
                        MinWidth="170"
                        Click="NewUserButton_Click"
                        Style="{StaticResource GoldButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/add.png"
                               Width="16" Height="16"
                               Margin="0,0,6,0"/>
                        <TextBlock Text="Новый пользователь"/>
                    </StackPanel>
                </Button>

                <!-- Изменить -->
                <Button x:Name="EditUserButton"
                        Margin="0,0,10,0"
                        MinWidth="120"
                        Click="EditUserButton_Click"
                        Style="{StaticResource GoldButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/edit.png"
                               Width="16" Height="16"
                               Margin="0,0,6,0"/>
                        <TextBlock Text="Изменить"/>
                    </StackPanel>
                </Button>

                <!-- Удалить -->
                <Button x:Name="DeleteUserButton"
                        MinWidth="120"
                        Click="DeleteUserButton_Click"
                        Style="{StaticResource GoldButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/delete.png"
                               Width="16" Height="16"
                               Margin="0,0,6,0"/>
                        <TextBlock Text="Удалить"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <!-- Таблица пользователей -->
        <DataGrid x:Name="UsersGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="UsersGrid_MouseDoubleClick">

            <DataGrid.Columns>
                <!-- Аватар -->
                <DataGridTemplateColumn Header=""
                                        Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="28" Height="28"
                                    BorderBrush="#555"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding PhotoImage}"
                                       Stretch="Uniform"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding UserId}"
                                    Width="60"/>

                <DataGridTextColumn Header="Логин"
                                    Binding="{Binding Login}"
                                    Width="150"/>

                <DataGridTextColumn Header="Роль"
                                    Binding="{Binding RoleName}"
                                    Width="150"/>

                <DataGridTextColumn Header="Сотрудник"
                                    Binding="{Binding EmployeeName}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
