<UserControl x:Class="AtlasServiceCenter.Pages.CashierPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10"
          Background="{StaticResource CardBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.ColumnSpan="2"
                   Text="Касса"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- ЛЕВО: заказы к оплате -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,10,0"
                Padding="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <TextBlock Text="Дата:"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <DatePicker x:Name="DateFilterPicker"
                                Width="130"
                                SelectedDateChanged="DateFilterPicker_SelectedDateChanged"/>
                    <CheckBox x:Name="TodayOnlyCheckBox"
                              Content="Только сегодня"
                              Margin="10,0,0,0"
                              IsChecked="True"
                              Checked="TodayOnlyCheckBox_Checked"
                              Unchecked="TodayOnlyCheckBox_Checked"/>
                </StackPanel>

                <DataGrid x:Name="OrdersGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="OrdersGrid_MouseDoubleClick"
                          Background="{StaticResource CardBackgroundBrush}"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding OrderId}"
                                            Width="60"/>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding CreatedAt, StringFormat=g}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Клиент"
                                            Binding="{Binding ClientName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Сумма"
                                            Binding="{Binding TotalAmount}"
                                            Width="90"/>
                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding StatusName}"
                                            Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ПРАВО: чек + история чеков -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Padding="8"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- выбранный заказ -->
                    <RowDefinition Height="Auto"/>
                    <!-- способ оплаты -->
                    <RowDefinition Height="*"/>
                    <!-- текст чека -->
                    <RowDefinition Height="Auto"/>
                    <!-- кнопки -->
                    <RowDefinition Height="*"/>
                    <!-- список чеков -->
                </Grid.RowDefinitions>

                <!-- Инфо о выбранном заказе -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <TextBlock Text="Выбранный заказ:"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="SelectedOrderInfoText"
                               Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Способ оплаты -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <TextBlock Text="Способ оплаты:"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="PaymentTypeCombo"
                              Width="180"
                              Margin="5,0,0,0">
                        <ComboBoxItem Content="Наличные" IsSelected="True"/>
                        <ComboBoxItem Content="Банковская карта"/>
                        <ComboBoxItem Content="Перевод на счёт"/>
                    </ComboBox>
                </StackPanel>

                <!-- Текст чека -->
                <TextBox x:Name="ReceiptTextBox"
                         Grid.Row="2"
                         Margin="0,5,0,5"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="NoWrap"
                         BorderBrush="{StaticResource GoldBrush}"
                         BorderThickness="1"/>

                <!-- Кнопки -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,5">
                    <Button Width="160"
                            Margin="0,0,8,0"
                            Click="GenerateReceiptButton_Click"
                            Style="{StaticResource GoldButtonStyle}">
                        <TextBlock Text="Сгенерировать чек"/>
                    </Button>
                    <Button Width="110"
                            Click="PrintReceiptButton_Click"
                            Style="{StaticResource GoldButtonStyle}">
                        <TextBlock Text="Печать"/>
                    </Button>
                </StackPanel>

                <!-- История чеков (оплаченные) -->
                <Border Grid.Row="4"
                        BorderBrush="#FFD9D9D9"
                        BorderThickness="1"
                        Padding="5"
                        Background="{StaticResource CardBackgroundBrush}">
                    <DockPanel>
                        <TextBlock Text="Оплаченные чеки"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Top"
                                   Margin="0,0,0,5"/>
                        <ListBox x:Name="ReceiptsListBox"
                                 MouseDoubleClick="ReceiptsListBox_MouseDoubleClick"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
