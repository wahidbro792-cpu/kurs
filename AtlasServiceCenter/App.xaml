<Application x:Class="AtlasServiceCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Windows/SplashScreenWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Цвета под стиль C (светлый серо-мраморный фон + золото) -->
            <Color x:Key="GoldColor">#FFC89A3A</Color>
            <Color x:Key="GoldDarkColor">#FF8E6924</Color>
            <Color x:Key="LightBackgroundColor">#FFF2F2F5</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="NavBackgroundColor">#FF25252A</Color>
            <Color x:Key="NavButtonBackgroundColor">#FF33333A</Color>

            <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
            <SolidColorBrush x:Key="GoldDarkBrush" Color="{StaticResource GoldDarkColor}"/>
            <SolidColorBrush x:Key="LightBackgroundBrush" Color="{StaticResource LightBackgroundColor}"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
            <SolidColorBrush x:Key="NavBackgroundBrush" Color="{StaticResource NavBackgroundColor}"/>
            <SolidColorBrush x:Key="NavButtonBackgroundBrush" Color="{StaticResource NavButtonBackgroundColor}"/>
            <SolidColorBrush x:Key="NavButtonForegroundBrush" Color="White"/>

            <!-- Базовый золотой стиль кнопки -->
            <Style x:Key="GoldButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  Margin="4,0,4,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource GoldBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource GoldDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Стиль кнопок навигации слева -->
            <Style x:Key="NavButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource GoldButtonStyle}">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Background" Value="{StaticResource NavButtonBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource NavButtonForegroundBrush}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
